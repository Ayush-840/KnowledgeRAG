# Where per-session Chroma + BM25 indexes live
CHROMA_PERSISTENCE_DIR=./chroma_data

# Retrieval knobs
RRF_K=60
RETRIEVE_CANDIDATES=20
RERANK_TOP_K=5

# Cross-encoder reranker
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_ENABLED=true

# Embedding model (swappable behind one interface)
# EMBEDDER=minilm          # default, all-MiniLM-L6-v2 (local)
# EMBEDDER=openai          # requires OPENAI_API_KEY
EMBEDDER=minilm
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Guardrails
MAX_UPLOAD_MB=50
MAX_CSV_ROWS=50000

# Per-query JSONL logging (Phase 2 observability)
QUERY_LOG_DIR=./logs

# Chat generation — required for /chat answers
# LLM_PROVIDER: "openrouter" (default) or "nvidia" (build.nvidia.com)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
# openrouter: openai/gpt-4o · nvidia: meta/llama-3.3-70b-instruct
GENERATION_MODEL=openai/gpt-4o
GENERATION_MAX_TOKENS=600

# Eval harness LLM-as-judge — qualitative metrics
EVAL_GENERATION_MODEL=openai/gpt-4o
EVAL_JUDGE_MODEL=openai/gpt-4o
